# Copy to .env and fill in. setup.sh generates the secrets for you.

# Public address of the dashboard. DNS for this host must point at the server
# before first start, so the HTTPS certificate can be issued.
BASE_URL=https://analytics.sbc-creative.com

# Secrets: generate with `openssl rand -base64 48` / `openssl rand -base64 32`
SECRET_KEY_BASE=
TOTP_VAULT_KEY=
POSTGRES_PASSWORD=

# Public sign-up stays off: accounts are created from the admin panel (/admin).
# The very first account registered on a fresh install becomes the founding admin.
DISABLE_REGISTRATION=invite_only

# Branding (these are the defaults)
BRAND_NAME=SBC
BRAND_PRODUCT_NAME=SBC Analytics
BRAND_LEGAL_NAME=SBC CREATIVE LLC
BRAND_SUPPORT_EMAIL=admin@sbc-creative.com
BRAND_WEBSITE_URL=https://sbc-creative.com
# AGPL-3.0: link to where users can get this modified source code (shown in the footer)
SOURCE_CODE_URL=

# Outgoing email (password resets, invitations, reports). Without SMTP no emails are sent.
MAILER_EMAIL=noreply@sbc-creative.com
MAILER_NAME=SBC Analytics
SMTP_HOST_ADDR=
SMTP_HOST_PORT=587
SMTP_USER_NAME=
SMTP_USER_PWD=
SMTP_HOST_SSL_ENABLED=false
