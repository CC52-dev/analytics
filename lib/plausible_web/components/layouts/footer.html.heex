<footer class="mt-24 border-t border-gray-200 dark:border-gray-800 print:hidden">
  <div class="container px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <PlausibleWeb.Components.Layout.logo class="w-24" />
        <span class="text-sm text-gray-500 dark:text-gray-400">
          {PlausibleWeb.Brand.copyright()}
        </span>
      </div>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a
          href={PlausibleWeb.Brand.support_mailto()}
          class="text-gray-600 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400"
        >
          Support
        </a>
        <a
          href={PlausibleWeb.Brand.website_url()}
          rel="noreferrer"
          target="_blank"
          class="text-gray-600 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400"
        >
          {PlausibleWeb.Brand.name()} website
        </a>
        <a
          :if={PlausibleWeb.Brand.source_code_url()}
          href={PlausibleWeb.Brand.source_code_url()}
          rel="noreferrer"
          target="_blank"
          class="text-gray-600 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400"
        >
          Source code (AGPL-3.0)
        </a>
      </nav>
    </div>
  </div>
</footer>
