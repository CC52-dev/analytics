<.focus_box>
  <:title>
    Welcome to {PlausibleWeb.Brand.product_name()}
  </:title>

  <p>
    Sign in to view the analytics for your websites. Need access or help? Contact
    <.styled_link href={PlausibleWeb.Brand.support_mailto()}>
      {PlausibleWeb.Brand.support_email()}
    </.styled_link>.
  </p>

  <:footer>
    <.focus_list>
      <:item>
        <.styled_link href={~p"/login"}>
          Sign in
        </.styled_link>
      </:item>
      <:item :if={Plausible.Auth.check_registration_enabled() == :ok}>
        <.styled_link href={~p"/register"}>
          Register
        </.styled_link>
      </:item>
    </.focus_list>
  </:footer>
</.focus_box>
